#!/bin/sh

echo "Running commit lint on commit message"
echo "------------------------------------------------"

# Run commitlint
bunx commitlint --edit "$1"
status=$?

# Check if commitlint failed
if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Invalid commit message!"
  echo "Your commit message must follow the conventional commit format:"
  echo ""
  echo "  <type>[optional scope]: <subject>"
  echo ""
  echo "Examples:"
  echo "  feat(api): add new booking endpoint"
  echo "  fix(web-vue): correct date picker validation"
  echo "  chore: update prettier and eslint configs"
  echo ""
  echo "Allowed types: feat, fix, chore, docs, style, refactor, test"
  echo ""
  exit 1
fi