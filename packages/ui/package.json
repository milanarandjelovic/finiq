{
  "name": "@finiq/ui",
  "version": "1.0.0",
  "private": true,
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "clean": "git clean -xdf .cache .next .turbo dist node_modules",
    "format": "prettier --write ./src/**/*",
    "ui:add": "bunx shadcn@latest add"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react-hook-form": "^7.73.1",
    "@hookform/resolvers": "^5.2.2"
  },
  "devDependencies": {
    "@finiq/eslint-config": "workspace:*",
    "@finiq/prettier-config": "workspace:*",
    "@finiq/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}
