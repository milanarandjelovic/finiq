{
  "name": "@finiq/translations",
  "version": "1.0.0",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src/",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "check-types": "tsc --noEmit",
    "check-translations": "tsx src/scripts/check-translations.ts",
    "find-missing-translations": "tsx src/scripts/find-missing-translations.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@finiq/eslint-config": "workspace:*",
    "@finiq/prettier-config": "workspace:*",
    "@finiq/typescript-config": "workspace:*",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.7",
    "eslint": "^9.36.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  }
}
