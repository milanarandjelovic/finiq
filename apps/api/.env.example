PORT=4000
BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4173

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Room Display JWT
ROOM_DISPLAY_JWT_SECRET=

# Database
DATASOURCE_HOST=127.0.0.1
DATASOURCE_DATABASE=finiq
DATASOURCE_PORT=5432
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=password
DATASOURCE_LOGGING=false

# Mailing setup
MAIL_TRANSPORT_HOST=sandbox.smtp.mailtrap.io
MAIL_TRANSPORT_PORT=2525
MAIL_TRANSPORT_USER=
MAIL_TRANSPORT_PASS=
MAIL_FROM="Finiq"

# Docs auth
DOCS_AUTH_USER=private
DOCS_AUTH_PASSWORD=folder

# Rate Limiting (TTL in milliseconds)
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_GLOBAL_TTL=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL=60000
THROTTLE_SENSITIVE_LIMIT=5
THROTTLE_SENSITIVE_TTL=60000

# Sentry
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
SENTRY_ENABLE_LOGS=false
SENTRY_PROFILE_LIFECYCLE=trace
SENTRY_SEND_DEFAULT_PII=false
